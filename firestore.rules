rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /conquest_analytics/{docId} {
      allow read, create, update, delete: if true;
    }

    match /conquest_islands/{islandId} {
      allow read, create, update, delete: if true;
    }

    match /conquest_servers/{serverId} {
      allow read, create, update, delete: if true;
      match /signaling_messages/{msgId} {
        allow read, create, update, delete: if true;
      }
    }
  }
}
